# Auf Cloudflare mit eigener Domain leer lassen. Auf GitHub Pages /Vitja-Website.
NEXT_PUBLIC_BASE_PATH=

# Vorschau: preview/false. Öffentliche Hauptdomain: production/true.
# Beide Werte werden beim Build gesetzt; nach einer Änderung neu bauen.
SITE_ENV=preview
NEXT_PUBLIC_SITE_INDEXING=false

# Öffentliche Website- und Unternehmensdaten
NEXT_PUBLIC_SITE_URL=https://triumphtechnicalservices.de
NEXT_PUBLIC_CONTACT_EMAIL=info@triumph-baugesellschaft.de
NEXT_PUBLIC_CONTACT_PHONE=+49 176 40076405
NEXT_PUBLIC_CONTACT_PHONE_HREF=+4917640076405
NEXT_PUBLIC_COMPANY_ADDRESS=Auf dem Jarten 6, 27607 Geestland
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Triumph Technical Services UG (haftungsbeschränkt)
NEXT_PUBLIC_COMPANY_REGISTER=HRB 211346
NEXT_PUBLIC_COMPANY_REGISTER_COURT=Amtsgericht Tostedt
# Nur befüllen, wenn eine solche Identifikationsnummer zugeteilt wurde.
NEXT_PUBLIC_COMPANY_VAT_ID=
NEXT_PUBLIC_COMPANY_BUSINESS_ID=
NEXT_PUBLIC_COMPANY_RESPONSIBLE=Viktor Jakobi, Geschäftsführer

# Formularversand über einen externen Dienst – der statische Export hat keinen
# eigenen Server. Der Access-Key ist bei Web3Forms öffentlich und darf im
# Client-Bundle stehen; ohne ihn zeigt das Formular einen mailto-Ausweg.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_CONTACT_ACCESS_KEY=
# Im Web3Forms-Dashboard hCaptcha für dieses Formular verpflichtend aktivieren.
# Der öffentliche hCaptcha-Sitekey ist im Client integriert. Kein Secret ins Repo.

# Datei-Uploads im Anfrageformular. Nur auf true setzen, wenn der
# Web3Forms-Tarif Datei-Anhänge unterstützt (Pro-Feature) – sonst bleiben die
# Upload-Felder ausgeblendet und die Bestätigung verweist auf E-Mail.
NEXT_PUBLIC_CONTACT_UPLOADS=false

# Nach Prüfung der Unternehmensdaten und Datenschutzhinweise durch den Betreiber.
# Die Freigaben werden nur bei SITE_ENV=production geprüft.
LEGAL_REVIEW_CONFIRMED=false
# Nach echter Zustellung einer Testanfrage UND Ablehnung ohne gültiges Captcha.
FORM_DELIVERY_CONFIRMED=false
SPAM_PROTECTION_CONFIRMED=false
# Nur erforderlich, wenn öffentliche Qualifikationsnachweise eingetragen werden.
QUALIFICATION_REVIEW_CONFIRMED=false
