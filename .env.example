# Pfadpräfix des statischen Exports. Auf GitHub Pages /Vitja-Website, lokal leer.
NEXT_PUBLIC_BASE_PATH=

# Öffentliche Website- und Unternehmensdaten
NEXT_PUBLIC_SITE_URL=https://www.ihre-domain.de
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@ihre-domain.de
NEXT_PUBLIC_CONTACT_PHONE=+49 000 000000
NEXT_PUBLIC_CONTACT_PHONE_HREF=+49000000000
NEXT_PUBLIC_COMPANY_ADDRESS=Straße 1, 00000 Ort
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Vollständiger Rechtsträger
NEXT_PUBLIC_COMPANY_REGISTER=Registergericht und Registernummer
NEXT_PUBLIC_COMPANY_TAX_ID=Umsatzsteuer-ID oder relevante Steuerangabe
NEXT_PUBLIC_COMPANY_RESPONSIBLE=Vor- und Nachname

# Formularversand über einen externen Dienst – der statische Export hat keinen
# eigenen Server. Der Access-Key ist bei Web3Forms öffentlich und darf im
# Client-Bundle stehen; ohne ihn zeigt das Formular einen mailto-Ausweg.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_CONTACT_ACCESS_KEY=

# Datei-Uploads im Anfrageformular. Nur auf true setzen, wenn der
# Web3Forms-Tarif Datei-Anhänge unterstützt (Pro-Feature) – sonst bleiben die
# Upload-Felder ausgeblendet und die Bestätigung verweist auf E-Mail.
NEXT_PUBLIC_CONTACT_UPLOADS=false

# Erst nach rechtlicher Prüfung setzen. Der Build prüft sie nur, wenn
# SITE_ENV=production gesetzt ist.
LEGAL_REVIEW_CONFIRMED=false
QUALIFICATION_REVIEW_CONFIRMED=false
